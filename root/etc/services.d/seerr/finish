#!/usr/bin/with-contenv bash

# s6 finish script — called when the seerr service exits
# $1 is the exit code from the run script; $2 is the signal number (if killed)
# Exit code 256 means s6 itself terminated the process (e.g., during container shutdown) — treat as clean exit.
# Any other non-zero exit is unexpected; stop the container so it can be restarted by the orchestrator.

if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
  echo "seerr exited with code ${1}; stopping container"
  s6-svscanctl -t /var/run/s6/services
fi
